{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductellence.local/schemas/review-record.schema.json",
  "title": "Conductellence Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "section_id",
    "procedure_id",
    "reviewer_class",
    "reviewer_id",
    "decision",
    "reasons",
    "recorded_at"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^CDX-REVREC-[A-Z0-9-]+$"
    },
    "section_id": {
      "type": "string",
      "pattern": "^CDX-LAW-001-"
    },
    "procedure_id": {
      "type": "string",
      "pattern": "^CDX-REV-"
    },
    "reviewer_class": {
      "enum": [
        "HUMAN_AUTHORIZED",
        "QUALIFIED_LEGAL_REVIEW",
        "HUMAN_CONSTITUTIONAL_AUTHORITY"
      ]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legal_basis_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legal_snapshot_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "artificial_approval": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "reasons": {
      "type": "string",
      "minLength": 1
    },
    "controls_imposed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "spetl_event_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
