{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductellence.local/schemas/applicability-decision.schema.json",
  "title": "Conductellence Exact-Provision Applicability Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "authority_ref",
    "system_id",
    "provision_id",
    "legal_snapshot_date",
    "facts",
    "result",
    "reasoning_state",
    "evidence_refs"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^CDX-LAD-[A-Z0-9-]+$"
    },
    "authority_ref": {
      "const": "CDX-CLR-LEGAL-BD-001"
    },
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provision_id": {
      "type": "string",
      "minLength": 1
    },
    "legal_snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "facts": {
      "type": "object",
      "additionalProperties": true
    },
    "result": {
      "enum": [
        "APPLIES",
        "DOES_NOT_APPLY",
        "PARTIALLY_APPLIES",
        "CONDITIONAL",
        "UNKNOWN",
        "LEGAL_REVIEW_REQUIRED"
      ]
    },
    "reasoning_state": {
      "type": "string",
      "minLength": 1
    },
    "scope_result": {
      "type": [
        "string",
        "null"
      ]
    },
    "temporal_result": {
      "type": [
        "string",
        "null"
      ]
    },
    "provision_condition_met": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "applicability_inferred_from_citation": {
      "const": false
    },
    "reasoning_summary": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decided_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
