      "scope_sources": [
        "CFR-51-1",
        "CFR-51-2"
      ],
      "required_facts": [
        "subject_type"
      ],
      "notes": "The Charter's field of application is not treated as a general private-entity applicability rule.",
      "outcomes": [
        {
          "rule_id": "CFR-SCOPE-001",
          "when": {
            "subject_type": "EU_INSTITUTION_BODY_OFFICE_AGENCY"
          },
          "result": "APPLIES",
          "source_refs": [
            "CFR-51-1"
          ]
        },
        {
          "rule_id": "CFR-SCOPE-002",
          "when": {
            "subject_type": "MEMBER_STATE_BODY",
            "implementing_union_law": true
          },
          "result": "APPLIES",
          "source_refs": [
            "CFR-51-1"
          ]
        },
        {
          "rule_id": "CFR-SCOPE-003",
          "when": {
            "subject_type": "MEMBER_STATE_BODY",
            "implementing_union_law": false
          },
          "result": "DOES_NOT_APPLY",
          "source_refs": [
            "CFR-51-1",
            "CFR-51-2"
          ]
        },
        {
          "rule_id": "CFR-SCOPE-004",
          "when": {
            "subject_type": "PRIVATE_ENTITY"
          },
          "result": "LEGAL_REVIEW_REQUIRED",
          "source_refs": [
            "CFR-51-1"
          ],
          "reason": "Direct/horizontal effect cannot be reduced to a generic deterministic private-entity rule."
        }
      ]
    },
