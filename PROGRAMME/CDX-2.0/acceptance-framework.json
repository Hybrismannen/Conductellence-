        "independent reference vs consumer runtime claims"
      ],
      "forbidden": [
        "one_consumer_is_estate_enforcing"
      ]
    },
    {
      "wp": "WP06",
      "deliverables": [
        "D06.1",
        "D06.2",
        "D06.3",
        "D06.4",
        "D06.5",
        "D06.6",
