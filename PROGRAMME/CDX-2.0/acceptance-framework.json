      ]
    }
  ],
  "state_promotion_rule": "WP state COMPLETE iff exact governing approvals + accepted evidence + main readback. A source-controlled candidate is not evidence of operational acceptance.",
  "scope_rule": "Acceptance claims limited to tested declared source/risk/jurisdiction scope. Do not self-certify broad legal or moral authority."
}
