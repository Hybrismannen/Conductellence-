  "proposed_control": {
    "control_id": "CDX-CTL-GDRIVE-001-PROPOSED",
    "section_id": "CDX-LAW-001-14-04",
    "title": "Director Google Drive create-only local effect gate",
    "status": "PROPOSED_NOT_IN_RELEASE",
    "enforcement_surface": "EXTERNAL_EFFECT",
    "decision_on_fail": "DENY",
    "predicate": {
      "op": "implies",
      "if": {
        "op": "equals",
        "path": "provider_id",
        "value": "google_drive"
      },
      "then": {
        "op": "all",
        "rules": [
          {
            "op": "equals",
            "path": "drive_guard.policy_id",
            "value": "OAI-DRIVE-APPEND-ONLY-001"
          },
          {
            "op": "equals",
            "path": "drive_guard.policy_pinned_verified",
            "value": true
          },
          {
            "op": "equals",
            "path": "drive_guard.credential_isolated",
            "value": true
          },
          {
            "op": "equals",
            "path": "drive_guard.target_id_verified",
            "value": true
          },
          {
            "op": "equals",
            "path": "drive_guard.pre_effect_evidence_ready",
            "value": true
          },
          {
            "op": "equals",
            "path": "drive_guard.revocation_checked",
            "value": true
          },
          {
            "op": "any",
            "rules": [
              {
                "op": "all",
                "rules": [
                  {
                    "op": "equals",
                    "path": "drive_guard.operation",
                    "value": "READ"
                  },
                  {
                    "op": "equals",
                    "path": "drive_guard.read_scope_verified",
                    "value": true
                  }
                ]
              },
              {
                "op": "all",
                "rules": [
                  {
                    "op": "equals",
                    "path": "drive_guard.operation",
                    "value": "CREATE_NEW"
                  },
                  {
                    "op": "equals",
                    "path": "drive_guard.parent_id_allowlisted",
                    "value": true
                  },
                  {
                    "op": "equals",
                    "path": "drive_guard.new_object_verified",
                    "value": true
                  },
                  {
                    "op": "equals",
                    "path": "drive_guard.session_bound",
                    "value": true
                  }
                ]
              },
              {
                "op": "all",
                "rules": [
                  {
                    "op": "equals",
                    "path": "drive_guard.operation",
                    "value": "MUTATE_EXISTING"
                  },
                  {
                    "op": "equals",
                    "path": "drive_guard.exact_target_signed_human_approval",
                    "value": true
                  },
                  {
                    "op": "equals",
                    "path": "drive_guard.approval_one_time_consumed",
                    "value": true
                  },
                  {
                    "op": "equals",
                    "path": "drive_guard.current_target_rechecked",
                    "value": true
                  },
                  {
                    "op": "equals",
                    "path": "drive_guard.mutation_executor_isolated",
                    "value": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "description": "Applies only to provider=google_drive. For non-Drive effects it does not add requirements. Existing Drive object mutation must pass exact-scope signed Director approval in a separate isolated executor; issuer cannot be agent-controlled.",
    "evidence_requirements": [
      "policy_decision",
      "SPETL PRE_EFFECT",
      "SPETL POST_EFFECT",
      "independent_custody"
    ],
