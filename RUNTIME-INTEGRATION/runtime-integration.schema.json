{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductellence.local/schemas/runtime-integration.schema.json",
  "title": "Conductellence Runtime Integration Registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "system_id",
    "authority_ref",
    "state",
    "enforcement_points",
    "policy_version",
    "spetl_mode",
    "tests"
  ],
  "properties": {
    "system_id": {
      "type": "string"
    },
    "authority_ref": {
      "const": "CDX-SYS-001"
    },
    "state": {
      "enum": [
        "BOUND_PENDING_RUNTIME_INTEGRATION",
        "BOUND_CI_MONITORED",
        "RUNTIME_GUARDED_UNVERIFIED",
        "VERIFIED_RUNTIME_BOUND"
      ]
    },
    "enforcement_points": {
      "type": "array"
    },
    "policy_version": {
      "type": "string"
    },
    "spetl_mode": {
      "enum": [
        "REQUIRED",
        "NOT_APPLICABLE"
      ]
    },
    "tests": {
      "type": "object"
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_evidence": {
      "type": "array"
    }
  }
}
