{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductellence.local/schemas/spetl-event.schema.json",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "recorded_at",
    "actor_id",
    "action",
    "decision",
    "authority_ref",
    "policy_version",
    "correlation_id",
    "causation_id"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "resource_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "enum": [
        "ALLOW",
        "ALLOW_WITH_CONTROLS",
        "REQUIRE_HUMAN",
        "QUARANTINE",
        "DENY",
        "SECURITY_STOP",
        "CONSTITUTIONAL_STOP"
      ]
    },
    "authority_ref": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "control_results": {
      "type": "array"
    },
    "evidence_refs": {
      "type": "array"
    },
    "previous_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_hash": {
      "type": "string"
    }
  }
}
