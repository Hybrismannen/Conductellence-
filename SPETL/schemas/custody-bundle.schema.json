{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductellence.local/schemas/spetl-custody-bundle.schema.json",
  "title": "Conductellence SPETL Custody Bundle",
  "type": "object",
  "required": [
    "schema",
    "bundle_id",
    "created_at",
    "producer",
    "source_commit",
    "expected_event_ids",
    "events",
    "bundle_hash"
  ],
  "properties": {
    "schema": {
      "const": "cdx.spetl.custody-bundle/v1.0"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "required": [
        "system_id",
        "runtime_id",
        "repository"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://conductellence.local/schemas/spetl-event.schema.json"
      }
    },
    "retention": {
      "type": "object",
      "required": [
        "class",
        "deletion_mode"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "deletion_mode": {
          "const": "GOVERNED_TOMBSTONE_AND_AUTHORIZED_ADMIN_ACTION"
        }
      },
      "additionalProperties": true
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
